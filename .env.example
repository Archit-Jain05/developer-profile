# Copy to .env and fill in from Supabase → Project Settings → API.
# Without these the site shows the bundled content and /admin is disabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" / publishable key. Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
